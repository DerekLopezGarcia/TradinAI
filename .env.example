# ==================== APIS DE MERCADO ====================

# ✅ CRIPTOMONEDAS (SIN API KEY - Ya funciona)
# Binance API pública (sin limitaciones)
# CoinGecko API pública (sin limitaciones)

# ✅ FOREX (SIN API KEY - Ya funciona parcialmente)
# Open Exchange Rates - 1500 llamadas/mes gratuitas
NEXT_PUBLIC_OPENEXCHANGERATES_KEY=tu_api_key_opcional

# 📌 ACCIONES, ÍNDICES, COMMODITIES (NECESITAS API KEY)

# Twelve Data - RECOMENDADO para acciones e índices
# Obtén tu API key en: https://twelvedata.com
# Rate limit gratuito: 500 llamadas/día
# Cubre: Acciones, Índices, ETFs, Forex
TWELVE_DATA_API_KEY=tu_api_key_aqui

# Finnhub API - Alternativa para acciones
# Obtén tu API key en: https://finnhub.io
# Rate limit gratuito: 60 calls/min
NEXT_PUBLIC_FINNHUB_KEY=tu_api_key_aqui

# Alpha Vantage API - Alternativa para acciones e indicadores
# Obtén tu API key en: https://www.alphavantage.co
# Rate limit gratuito: 5 calls/min
NEXT_PUBLIC_ALPHAVANTAGE_KEY=tu_api_key_aqui

# Quandl - RECOMENDADO para Commodities (Oro, Petróleo, Granos)
# Obtén tu API key en: https://www.quandl.com
# Rate limit gratuito: 20 llamadas/10 min
QUANDL_API_KEY=tu_api_key_aqui

# NewsAPI - Noticias de mercado y análisis
# Obtén tu API key en: https://newsapi.org
NEXT_PUBLIC_NEWS_API_KEY=tu_api_key_aqui

# IEX Cloud - Alternativa para acciones
# Obtén tu API key en: https://iexcloud.io
# Rate limit gratuito: 100 mensajes/mes
IEX_CLOUD_API_KEY=tu_api_key_aqui

# OANDA - Para datos Forex avanzados
# Obtén en: https://developer.oanda.com
# Requiere: API Key + Account ID
OANDA_API_KEY=tu_clave_aqui
OANDA_ACCOUNT_ID=tu_cuenta_aqui

# ==================== INTELIGENCIA ARTIFICIAL ====================

# API Key de IA (si necesitas usarla)
# NEXT_PUBLIC_AI_API_KEY=tu_api_key_aqui

# ==================== CONFIGURACIÓN DE APLICACIÓN ====================

# Entorno
NODE_ENV=development

# URL Base (usar para llamadas API en servidor)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ==================== 🚀 GUÍA DE CONFIGURACIÓN RÁPIDA ====================

# PASO 1: Copia este archivo a .env.local
#         cp .env.example .env.local

# PASO 2: Obtén las API keys que necesitas (5 minutos):
#
#         OPCIÓN A - Máximo funcionalidad (RECOMENDADO):
#         - Twelve Data (acciones, índices): https://twelvedata.com
#         - Quandl (commodities): https://www.quandl.com
#
#         OPCIÓN B - Mínimo (solo lo esencial):
#         - Twelve Data (acciones, índices): https://twelvedata.com

# PASO 3: Reemplaza los valores en .env.local con tus claves reales

# PASO 4: Reinicia el servidor
#         npm run dev

# PASO 5: Verifica que funciona
#         node test-all-apis.js

# ==================== 📊 COBERTURA SIN / CON API KEYS ====================

# SIN API KEYS (funcionan así):
# ✅ Criptomonedas - Binance (público)
# ✅ Forex - Parcial (Open Rates público)
# ❌ Acciones
# ❌ Índices
# ❌ Commodities
# ❌ Todo lo demás

# CON TWELVE_DATA_API_KEY:
# ✅ Acciones (todas)
# ✅ Índices (todos)
# ✅ ETFs
# ✅ Forex (completo)
# ✅ Bonos

# CON QUANDL_API_KEY:
# ✅ Commodities (oro, petróleo, granos, metales)
# ✅ Energía
# ✅ Agricultura

# ==================== 💡 NOTAS ====================

# - Todas las APIs tienen plan GRATUITO
# - SIN necesidad de tarjeta de crédito para plan gratuito
# - Fallback automático: si falla una API, se intenta otra
# - Las variables NEXT_PUBLIC_ se exponen en el navegador (es seguro)
# - Las variables SIN NEXT_PUBLIC_ solo se usan en servidor (privadas)


# 2. Obtén tus API keys
# 3. Copia este archivo: cp .env.example .env.local
# 4. Reemplaza los valores de ejemplo con tus keys reales
# 5. Reinicia el servidor: npm run dev

# Ver ENV_SETUP.md para guía detallada de configuración


