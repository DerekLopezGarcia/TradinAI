#!/bin/bash

# ============================================
# Pre-commit Security Hook
# Previene commits de archivos sensibles
# ============================================

# Colores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Archivos que NUNCA deben ser commiteados
FORBIDDEN_FILES=(
  ".env.local"
  ".env.*.local"
  ".env"
  "package-lock.json"  # Opcional: evitar lock files
)

# Archivos que contienen PATRONES de claves secretas
FORBIDDEN_PATTERNS=(
  "TWELVE_DATA_API_KEY\s*=\s*[^tu_api_key]"
  "QUANDL_API_KEY\s*=\s*[^tu_api_key]"
  "NEXT_PUBLIC_FINNHUB_KEY\s*=\s*[^tu_api_key]"
  "sk_live_"
  "pk_live_"
  "BEGIN RSA PRIVATE KEY"
  "BEGIN PRIVATE KEY"
)

echo "🔐 Validando cambios antes de commit..."

FAILED=0

# Verificar archivos prohibidos
for file in "${FORBIDDEN_FILES[@]}"; do
  if git diff --cached --name-only | grep -E "^${file}$" > /dev/null; then
    echo -e "${RED}❌ ERROR: No se puede commitear '$file'${NC}"
    echo "   Este archivo contiene secretos y está protegido."
    FAILED=1
  fi
done

# Verificar patrones de claves
for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
  if git diff --cached -S "$pattern" | grep -q "$pattern"; then
    echo -e "${RED}❌ ERROR: Se detectó una posible clave API${NC}"
    echo "   Patrón: $pattern"
    FAILED=1
  fi
done

if [ $FAILED -eq 0 ]; then
  echo -e "${GREEN}✅ Validación de seguridad: PASADA${NC}"
  exit 0
else
  echo ""
  echo -e "${YELLOW}⚠️  FIX:${NC}"
  echo "   1. Copia .env.example a .env.local"
  echo "   2. Edita .env.local con tus claves"
  echo "   3. .env.local está en .gitignore (no se sube)"
  echo "   4. Intenta commit de nuevo"
  exit 1
fi

